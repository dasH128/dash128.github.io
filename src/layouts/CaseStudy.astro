---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  /** Columns of the screenshot gallery on wide screens. */
  cols?: number;
}

const { title, description, cols = 3 } = Astro.props;
const year = new Date().getFullYear();
---

<Base lang="en" title={title} description={description} home={false}>
  <div class="case" style={`--cols:${cols}`}>
    <slot />
    <footer class="case__foot">
      <div class="wrap case__foot-row">
        <a href="/#work">← Back to portfolio</a>
        <span>© {year} Jordy Rojas Aliaga</span>
      </div>
    </footer>
  </div>
</Base>

<!-- Shared look for every case-study page: they only supply markup, this supplies the style. -->
<style is:global>
  .case .top {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 0.8rem;
    background: var(--paper);
    border-bottom: var(--rule) solid var(--ink);
  }

  .case .top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .case .top__links,
  .case .footer-links {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .case .back-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case .link-underline {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: color 0.2s var(--ease-out);
  }

  .case .link-underline:hover {
    color: var(--blue);
  }

  /* Old class names, new button. */
  .case .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.6em 1.1em;
    background: var(--blue);
    color: #fff;
    border: var(--rule) solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .case .pill:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .case .hero-block {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case .eyebrow-tag {
    width: fit-content;
    padding: 0.35em 0.7em;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case h1 {
    font-size: clamp(2.8rem, 8.5vw, 7rem);
    line-height: 0.95;
    max-width: 14ch;
  }

  .case .lede {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .case .tags {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }

  .case .tags li {
    padding: 0.25em 0.6em;
    border: 1.5px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case .block {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-top: var(--rule) solid var(--ink);
  }

  .case .block--last {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .case .block h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .case .block p {
    max-width: 68ch;
  }

  .case code {
    font-family: var(--font-mono);
    background: var(--paper-dim);
    padding: 0.1em 0.4em;
    font-size: 0.88em;
  }

  .case .controllers {
    display: flex;
    flex-direction: column;
    border-top: var(--rule) solid var(--ink);
  }

  .case .controller-row {
    display: grid;
    grid-template-columns: minmax(160px, 260px) 1fr;
    gap: 1.5rem;
    padding-block: 1.1rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .case .controller-base {
    align-self: start;
    width: fit-content;
    color: var(--blue);
    font-weight: 500;
  }

  .case .controller-row p {
    color: var(--ink-soft);
  }

  .case .code-block {
    margin: 0.5rem 0 0;
    padding: 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border: var(--rule) solid var(--ink);
    box-shadow: 6px 6px 0 var(--blue);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .case .code-block code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .case .code-caption {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .case .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: 0.5rem;
  }

  .case .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: var(--rule) solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    background: #fff;
  }

  .case .shot img {
    width: 100%;
    border-bottom: var(--rule) solid var(--ink);
  }

  .case .shot figcaption {
    padding: 0.9rem 1.1rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    background: var(--paper);
    flex: 1;
  }

  .case .case__foot {
    background: var(--ink);
    color: var(--paper);
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case .case__foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .case .case__foot a {
    color: inherit;
    text-underline-offset: 4px;
  }

  .case .case__foot a:hover {
    color: var(--blue-on-ink);
  }

  @media (max-width: 780px) {
    .case .gallery {
      grid-template-columns: repeat(min(var(--cols, 3), 2), minmax(0, 1fr));
    }
    .case .controller-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (max-width: 520px) {
    .case .gallery {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case .pill,
    .case .link-underline {
      transition: none;
    }
  }
</style>
