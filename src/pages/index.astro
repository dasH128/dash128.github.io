---
import { langPath } from "../i18n/content";

const fallback = langPath("en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Jordy Rojas Aliaga</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript><meta http-equiv="refresh" content={`0;url=${fallback}`} /></noscript>
    <script is:inline define:vars={{ es: langPath("es"), en: langPath("en") }}>
      // Saved choice first, then the browser language, then English.
      var lang = "en";
      try {
        var saved = localStorage.getItem("lang");
        if (saved === "es" || saved === "en") lang = saved;
        else {
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          for (var i = 0; i < prefs.length; i++) {
            var p = String(prefs[i]).toLowerCase();
            if (p.indexOf("es") === 0) { lang = "es"; break; }
            if (p.indexOf("en") === 0) { lang = "en"; break; }
          }
        }
      } catch (e) {}
      location.replace((lang === "es" ? es : en) + location.hash);
    </script>
  </head>
  <body>
    <p><a href={langPath("en")}>English</a> · <a href={langPath("es")}>Español</a></p>
  </body>
</html>
