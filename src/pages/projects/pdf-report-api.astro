---
import "../../styles/global.css";

const description =
  "A NestJS + Prisma API that turns database records into PDF reports on demand — invoices, certificates, tables, and dashboards with embedded charts.";

const controllers = [
  {
    base: "/basic-report",
    summary:
      "Certificates and reference tables — an employment letter rendered from a live employee record, and a country list that can be filtered by continent.",
  },
  {
    base: "/extra-reports",
    summary:
      "Format experiments — converting an existing HTML template straight to PDF, a fixed-layout report, and a custom page size with an embedded QR code.",
  },
  {
    base: "/store-reports",
    summary:
      "Data-driven reports — a purchase invoice built from a real order (customer, products, totals), and a statistics dashboard combining a Prisma groupBy with a raw SQL join.",
  },
];

const shots = [
  {
    src: "/projects/pdf-report-api/statistics.png",
    alt: "Statistics report PDF: a donut chart of top customer countries, a line chart, a bar chart, and a radar chart on one page",
    caption: "Customer & inventory statistics — Prisma groupBy + a raw SQL join, rendered as charts.",
  },
  {
    src: "/projects/pdf-report-api/invoice.png",
    alt: "Purchase invoice PDF with a QR code, customer details, and a line-item table",
    caption: "A purchase order rendered as an invoice, pulled live from Prisma.",
  },
  {
    src: "/projects/pdf-report-api/countries.png",
    alt: "Countries report PDF showing a striped table with ISO codes, names, continents, and local names",
    caption: "A 12-page country table with striped rows and a repeating header.",
  },
  {
    src: "/projects/pdf-report-api/html-report.png",
    alt: "PDF rendered from an existing HTML template, showing headings, lists, and inline styles",
    caption: "An existing HTML template converted straight to PDF.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>PDF Report Generation API — Jordy Rojas Aliaga</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap top__row">
        <a href="/#work" class="back-link link-underline">← Back to portfolio</a>
        <a class="pill pill--primary" href="https://github.com/dasH128/pdf-report-api-nest" target="_blank" rel="noopener">
          View on GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero-block wrap">
        <span class="eyebrow-tag">Personal Project · 2024</span>
        <h1>PDF Report Generation API</h1>
        <p class="lede">
          A NestJS backend that turns PostgreSQL data into PDF reports on demand — invoices, certificates,
          reference tables, and dashboards with embedded SVG charts — built directly on PDFKit, with no
          templating engine in between.
        </p>
        <ul class="tags">
          {["NestJS", "Prisma", "PostgreSQL", "pdfmake", "PDFKit", "Chart.js"].map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </section>

      <section class="wrap block">
        <h2>Why I built it</h2>
        <p>
          I started this after finishing DevTalles' "Nest + Reportes: Genera PDF desde Node" course, then kept
          extending it on my own — adding new report types, real Prisma queries instead of static data, and
          SVG charts rendered server-side instead of pre-baked images. It's the project I use to practice
          backend patterns I don't get to touch as often on the mobile and Flutter work I do day to day at
          Motorline.
        </p>
      </section>

      <section class="wrap block">
        <h2>Architecture</h2>
        <p>
          Every endpoint follows the same path: a controller resolves the request, a service pulls data
          through Prisma (or runs a raw query when Prisma's query builder can't express it), and a shared
          <code>PrinterService</code> turns a pdfmake document definition into a PDF stream. Nothing is
          cached or persisted — each request rebuilds the document from live data.
        </p>

        <div class="controllers">
          {controllers.map((c) => (
            <div class="controller-row">
              <code class="controller-base">{c.base}</code>
              <p>{c.summary}</p>
            </div>
          ))}
        </div>

        <pre class="code-block"><code>{`async getStatisticsService(): Promise<PDFKit.PDFDocument> {
  const topCountries = await this.customers.groupBy({
    by: ['country'],
    _count: true,
    orderBy: { _count: { country: 'desc' } },
    take: 10,
  });

  const infoCategories = await this.$queryRaw\`
    SELECT COUNT(*) AS TOTAL, C.CATEGORY_NAME
    FROM PRODUCTS P
    INNER JOIN CATEGORIES C ON P.CATEGORY_ID = C.CATEGORY_ID
    GROUP BY P.CATEGORY_ID, C.CATEGORY_NAME\`;

  const docDefinition = await getStatisticsReport({
    topCountries: topCountryData,
    infoCategories: infoCategoryData,
  });
  return this.printerService.createPdf(docDefinition);
}`}</code></pre>
        <p class="code-caption">
          <code>store-reports.service.ts</code> — mixing a Prisma <code>groupBy</code> with a raw SQL join,
          then handing both datasets to a report builder function.
        </p>
      </section>

      <section class="wrap block">
        <h2>Sample output</h2>
        <p>Screenshots below are real PDFs generated by the running API against a seeded database, not mockups.</p>

        <div class="gallery">
          {shots.map((s) => (
            <figure class="shot">
              <img src={s.src} alt={s.alt} loading="lazy" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="wrap block block--last">
        <h2>Stack</h2>
        <p>
          NestJS on the API layer, Prisma against PostgreSQL for data access, <code>pdfmake</code> for
          document composition and layout, PDFKit underneath for the actual PDF stream, and Chart.js
          (rendered server-side to SVG/PNG) for the charts embedded in the statistics report.
        </p>
        <a class="pill pill--primary" href="https://github.com/dasH128/pdf-report-api-nest" target="_blank" rel="noopener">
          View the source on GitHub
        </a>
      </section>
    </main>
  </body>
</html>

<style>
  .top {
    padding-block: 1.25rem;
    border-bottom: var(--stroke) solid var(--line);
    background: var(--paper);
  }

  .top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-family: "Bricolage Grotesque", sans-serif;
  }

  .hero-block {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .eyebrow-tag {
    display: inline-block;
    width: fit-content;
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    border: 1.25px solid var(--line);
    background: var(--periwinkle);
    color: var(--periwinkle-ink);
  }

  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    line-height: 1.1;
    max-width: 20ch;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .tags {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags li {
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.35em 0.85em;
    border-radius: 999px;
    border: 1.25px solid var(--line);
  }

  .block {
    padding-block: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-top: var(--stroke) solid var(--line);
  }

  .block--last {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .block h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .block p {
    max-width: 68ch;
  }

  code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    background: var(--paper-dim);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.92em;
  }

  .controllers {
    display: flex;
    flex-direction: column;
    border-top: var(--stroke) solid var(--line);
  }

  .controller-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: var(--stroke) solid var(--line);
  }

  .controller-base {
    align-self: start;
    width: fit-content;
  }

  .controller-row p {
    color: var(--ink-soft);
  }

  .code-block {
    background: var(--night);
    color: var(--night-ink);
    border-radius: var(--radius-md);
    border: var(--stroke) solid var(--line);
    padding: 1.5rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .code-block code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .code-caption {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    background: #ffffff;
  }

  .shot img {
    width: 100%;
    display: block;
    border-bottom: var(--stroke) solid var(--line);
  }

  .shot figcaption {
    padding: 0.9rem 1.1rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (max-width: 780px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .controller-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
