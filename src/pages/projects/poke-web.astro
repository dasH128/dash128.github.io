---
import CaseStudy from "../../layouts/CaseStudy.astro";

const description =
  "A Vue 3 + TypeScript trivia game built on PokeAPI: guess the Pokémon from its silhouette before the clock — and your hearts — run out, across three difficulty tiers with a local high-score board.";

const modules = [
  {
    base: "api/pokemonApi.ts",
    summary:
      "A single Axios instance pointed at PokeAPI's /pokemon endpoint — every request for a Pokémon's name and id goes through it.",
  },
  {
    base: "helper/getPokemonOptions.ts",
    summary:
      "Shuffles the 650 Kanto-through-Unova ids client-side, takes four, and resolves all four PokeAPI requests in parallel with Promise.all.",
  },
  {
    base: "helper/dificultad.ts + scoreStorage.ts",
    summary:
      "Difficulty presets (lives, seconds per question, hints, total time) and a localStorage-backed top-10 leaderboard, re-sorted and trimmed on every save.",
  },
];

const shots = [
  {
    src: "/projects/poke-web/menu.png",
    alt: "Main menu styled as a holographic Kanto terminal, with a blurred Pokémon silhouette on the left and Empezar, Configurar, Puntajes and Créditos options on the right",
    caption: "Main menu — the holographic-terminal redesign, with a live silhouette preview.",
  },
  {
    src: "/projects/poke-web/config.png",
    alt: "Difficulty selection screen showing Fácil, Normal and Difícil options, each listing their lives, time per question and available hints",
    caption: "Difficulty picker — Fácil, Normal and Difícil each tune lives, time and hints differently.",
  },
  {
    src: "/projects/poke-web/game.png",
    alt: "Game screen with a black Pokémon silhouette inside a Pokédex-style scanner, a countdown timer, a hint button and four answer options below",
    caption: "The guessing screen — a countdown, a hint button, and four PokeAPI-sourced options.",
  },
];
---

<CaseStudy title="¿Quién es ese Pokémon? — Jordy Rojas Aliaga" description={description} cols={3}>
    <header class="top">
      <div class="wrap top__row">
        <a href="/#work" class="back-link link-underline">← Back to portfolio</a>
        <div class="top__links">
          <a class="pill pill--primary" href="https://pokigame.netlify.app/" target="_blank" rel="noopener">
            Live demo
          </a>
          <a class="pill pill--primary" href="https://github.com/dasH128/poke-web" target="_blank" rel="noopener">
            View on GitHub
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero-block wrap">
        <span class="eyebrow-tag">Personal Project · 2021–2026</span>
        <h1>¿Quién es ese Pokémon?</h1>
        <p class="lede">
          A Vue 3 + TypeScript trivia game that turns PokeAPI into a "Who's That Pokémon?" quiz: a silhouette
          appears, a countdown starts, and you pick the right name from four options before your hearts — or
          the clock — run out.
        </p>
        <ul class="tags">
          {["Vue 3", "TypeScript", "Axios", "PokeAPI", "Vue CLI"].map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </section>

      <section class="wrap block">
        <h2>Why I built it</h2>
        <p>
          This was one of my first Vue 3 + TypeScript projects, built in 2021 to practice component
          composition, computed properties, and pulling live data from a public REST API instead of static
          fixtures. I came back to it in 2026 to redesign the interface from scratch — the current
          "holographic Kanto terminal" look — while leaving the original game logic untouched.
        </p>
      </section>

      <section class="wrap block">
        <h2>What it does</h2>
        <p>
          Every round shuffles the 650 Kanto-through-Unova Pokémon ids, fetches four of them from PokeAPI,
          and renders one as a black silhouette that only reveals itself once you answer. The difficulty
          picked at the start — Fácil, Normal, or Difícil — sets your lives, the seconds per question, and
          how many hints you get; each hint strips two of the three wrong options down to a 50/50 guess.
          Normal and Difícil add a shared total-game clock that costs a life and resets every time it runs
          out. Final scores are saved straight to a local top-10 leaderboard, no backend involved.
        </p>
      </section>

      <section class="wrap block">
        <h2>Architecture</h2>
        <p>
          There's no router or state library — <code>App.vue</code> just toggles between the menu and the
          game screen via a prop/emit pair, and each screen owns its own state through the Options API. The
          logic that isn't UI lives in three small, single-purpose modules:
        </p>

        <div class="controllers">
          {modules.map((m) => (
            <div class="controller-row">
              <code class="controller-base">{m.base}</code>
              <p>{m.summary}</p>
            </div>
          ))}
        </div>

        <pre class="code-block"><code>{`usarAyuda() {
  if (this.ayudasRestantes <= 0 || this.ayudaUsadaEnPregunta || this.mostrarRespuesta) return

  const correcta = this.opcionesMostradas.find(p => p.id === this.pokemon.id)
  const incorrectas = this.opcionesMostradas.filter(p => p.id !== this.pokemon.id)
  const incorrectaAlAzar = incorrectas[Math.floor(Math.random() * incorrectas.length)]

  this.opcionesMostradas = [correcta, incorrectaAlAzar].sort(() => Math.random() - 0.5)
  this.ayudasRestantes--
  this.ayudaUsadaEnPregunta = true
}`}</code></pre>
        <p class="code-caption">
          <code>PokemonPage.vue</code> — using a hint keeps the correct Pokémon and one random decoy, then
          reshuffles the two so the answer's position on screen doesn't give it away.
        </p>
      </section>

      <section class="wrap block">
        <h2>Screens</h2>
        <p>Screenshots below are from the app running locally, not mockups.</p>

        <div class="gallery">
          {shots.map((s) => (
            <figure class="shot">
              <img src={s.src} alt={s.alt} loading="lazy" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="wrap block block--last">
        <h2>Stack</h2>
        <p>
          Vue 3 with the Options API and TypeScript for the app itself, Axios talking directly to PokeAPI
          with no caching layer in between, and utility-class styling with a handful of scoped keyframe
          animations for the Pokédex scanlines and lens glow.
        </p>
        <div class="footer-links">
          <a class="pill pill--primary" href="https://pokigame.netlify.app/" target="_blank" rel="noopener">
            Try the live demo
          </a>
          <a class="pill pill--primary" href="https://github.com/dasH128/poke-web" target="_blank" rel="noopener">
            View the source on GitHub
          </a>
        </div>
      </section>
    </main>
</CaseStudy>
