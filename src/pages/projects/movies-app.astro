---
import "../../styles/global.css";

const description =
  "A Flutter mobile app for discovering movies — now playing, popular, and upcoming titles from TMDB, with debounced search, cast and synopsis on every detail page, and favorites persisted offline with Isar.";

const layers = [
  {
    base: "domain",
    summary:
      "Framework-agnostic core — the Movie and Actor entities, and the abstract repository/datasource contracts the rest of the app depends on.",
  },
  {
    base: "infraestructure",
    summary:
      "TMDB's REST responses mapped into domain entities through Dio, plus an Isar datasource that reads and writes favorites on-device.",
  },
  {
    base: "presentation",
    summary:
      "Riverpod providers driving state, go_router for navigation, and the screens/widgets — the only layer that knows either exists.",
  },
];

const shots = [
  {
    src: "/projects/movies-app/home.jpg",
    alt: "Home screen with a featured-movies slideshow, an now-playing row, and an upcoming row",
    caption: "Home — featured slideshow, now playing, and upcoming.",
  },
  {
    src: "/projects/movies-app/dark-home.jpg",
    alt: "The same home screen rendered in dark mode",
    caption: "Dark Home — applies instantly across every screen.",
  },
  {
    src: "/projects/movies-app/detail.jpg",
    alt: "Movie detail screen showing the synopsis, genre tags, cast photos, and a filled favorite icon",
    caption: "Detail — synopsis, genres, and cast, with the favorite toggle.",
  },
  {
    src: "/projects/movies-app/dark-detail.png",
    alt: "Movie detail screen showing the synopsis, genre tags, cast photos, and a filled favorite icon",
    caption: "Dark Detail — synopsis, genres, and cast, with the favorite toggle.",
  },
  {
    src: "/projects/movies-app/search.jpg",
    alt: "Search results list showing several movies matching a query, each with a rating",
    caption: "Search — debounced 500ms against the TMDB API as you type.",
  },
  {
    src: "/projects/movies-app/dark-search.png",
    alt: "Search results list showing several movies matching a query, each with a rating",
    caption: "Dark Search — debounced 500ms against the TMDB API as you type.",
  },
  {
    src: "/projects/movies-app/favorites.png",
    alt: "Favorites screen showing a masonry grid of two saved movie posters",
    caption:
      "Favorites — persisted on-device with Isar, no network round trip.",
  },
  {
    src: "/projects/movies-app/dark-favorites.png",
    alt: "Favorites screen showing a masonry grid of two saved movie posters",
    caption:
      "Dark Favorites — persisted on-device with Isar, no network round trip.",
  },

  {
    src: "/projects/movies-app/dark-settings.jpg",
    alt: "Settings screen in dark mode with language, accent color, and a dark mode switch",
    caption:
      "Dark Settings — language, one of 15 accent colors, and the theme switch.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>Cinemapedia — Jordy Rojas Aliaga</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap top__row">
        <a href="/#work" class="back-link link-underline">← Back to portfolio</a
        >
        <a
          class="pill pill--primary"
          href="https://github.com/dasH128/movies-app-flutter"
          target="_blank"
          rel="noopener"
        >
          View on GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero-block wrap">
        <span class="eyebrow-tag">Personal Project · 2024</span>
        <h1>Cinemapedia</h1>
        <p class="lede">
          A Flutter mobile app for browsing and searching movies from TMDB — now
          playing, popular, top rated, and upcoming, each with cast and
          synopsis, favorites saved offline, and a light/dark theme with a
          choice of 15 accent colors.
        </p>
        <ul class="tags">
          {
            [
              "Flutter",
              "Dart",
              "Riverpod",
              "go_router",
              "Isar",
              "TMDB API",
            ].map((t) => <li>{t}</li>)
          }
        </ul>
      </section>

      <section class="wrap block">
        <h2>What it does</h2>
        <p>
          The home screen pulls four TMDB lists — now playing, popular, top
          rated, and upcoming — into infinite-scrolling rows, with the
          now-playing titles doubling as a featured slideshow up top. Tapping a
          poster opens a detail screen with the synopsis, genre tags, and cast
          photos pulled from TMDB's credits endpoint. A magnifying-glass icon
          opens a debounced search over the same API, and every detail screen
          has a favorite toggle that persists to an on-device Isar database, so
          the favorites tab reads instantly with no network call.
        </p>
      </section>

      <section class="wrap block">
        <h2>Architecture</h2>
        <p>
          The app follows a clean-architecture split into three layers, each
          only aware of the one below it:
        </p>

        <div class="controllers">
          {
            layers.map((l) => (
              <div class="controller-row">
                <code class="controller-base">{l.base}</code>
                <p>{l.summary}</p>
              </div>
            ))
          }
        </div>

        <pre
          class="code-block"><code>{`class MoviesNotifier extends StateNotifier<MoviesState> {
  int currentPage = 0;
  MovieCallback fetchMoreMovies;

  MoviesNotifier({required this.fetchMoreMovies})
      : super(MoviesState(movies: [])) {
    loadNextPage();
  }

  Future loadNextPage() async {
    if (state.isLoading) return;

    currentPage++;
    state = state.copyWith(isLoading: true);
    final movies = await fetchMoreMovies(page: currentPage);
    state = state.copyWith(movies: [...state.movies, ...movies]);
    await Future.delayed(const Duration(milliseconds: 300));
    state = state.copyWith(isLoading: false);
  }
}`}</code></pre>
        <p class="code-caption">
          <code>movies_provider.dart</code> — the same <code>StateNotifier</code
          > pagination pattern backs all four home lists; only the fetch callback
          each one is built with changes.
        </p>
      </section>

      <section class="wrap block">
        <h2>Screens</h2>
        <p>Screenshots below are from the app running on an iOS Simulator.</p>

        <div class="gallery">
          {
            shots.map((s) => (
              <figure class="shot">
                <img src={s.src} alt={s.alt} loading="lazy" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="wrap block block--last">
        <h2>Stack</h2>
        <p>
          Flutter and Dart for the app itself, <code>flutter_riverpod</code> for state
          management, and
          <code>go_router</code> for navigation. Movie data comes from the TMDB REST
          API through Dio, and favorites are stored on-device with <code
            >Isar</code
          > — no backend of its own.
        </p>
        <a
          class="pill pill--primary"
          href="https://github.com/dasH128/movies-app-flutter"
          target="_blank"
          rel="noopener"
        >
          View the source on GitHub
        </a>
      </section>
    </main>
  </body>
</html>

<style>
  .top {
    padding-block: 1.25rem;
    border-bottom: var(--stroke) solid var(--line);
    background: var(--paper);
  }

  .top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-family: "Bricolage Grotesque", sans-serif;
  }

  .hero-block {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .eyebrow-tag {
    display: inline-block;
    width: fit-content;
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    border: 1.25px solid var(--line);
    background: var(--rust);
    color: var(--rust-ink);
  }

  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    line-height: 1.1;
    max-width: 20ch;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .tags {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags li {
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.35em 0.85em;
    border-radius: 999px;
    border: 1.25px solid var(--line);
  }

  .block {
    padding-block: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-top: var(--stroke) solid var(--line);
  }

  .block--last {
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .block h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .block p {
    max-width: 68ch;
  }

  code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    background: var(--paper-dim);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.92em;
  }

  .controllers {
    display: flex;
    flex-direction: column;
    border-top: var(--stroke) solid var(--line);
  }

  .controller-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: var(--stroke) solid var(--line);
  }

  .controller-base {
    align-self: start;
    width: fit-content;
  }

  .controller-row p {
    color: var(--ink-soft);
  }

  .code-block {
    background: var(--night);
    color: var(--night-ink);
    border-radius: var(--radius-md);
    border: var(--stroke) solid var(--line);
    padding: 1.5rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .code-block code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .code-caption {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    background: #ffffff;
  }

  .shot img {
    width: 100%;
    display: block;
    border-bottom: var(--stroke) solid var(--line);
  }

  .shot figcaption {
    padding: 0.9rem 1.1rem 1.1rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  @media (max-width: 780px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .controller-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (max-width: 520px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
