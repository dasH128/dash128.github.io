---
import { content, formatMonth, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].education;
---

<section id="education">
  <div class="wrap">
    <h2 class="section-title">{t.title}</h2>

    <div class="edu">
      <div class="edu__col">
        <h3 class="mono edu__label">{t.studies}</h3>
        <ul class="edu__list">
          {
            t.degrees.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.place}
                </span>
                <span class="mono">{e.dates}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="edu__col">
        <h3 class="mono edu__label">{t.certs}</h3>
        <ul class="edu__list">
          {
            t.certifications.map((c) => (
              <li>
                <strong>{c.name}</strong>
                <span>
                  {c.issuer} · {formatMonth(c.date, lang)}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .edu__label {
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-soft);
    padding-bottom: 0.9rem;
  }

  .edu__list {
    list-style: none;
    padding: 0;
    border-top: var(--rule) solid var(--ink);
  }

  .edu__list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-block: 1rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .edu__list strong {
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .edu__list span {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .edu__list .mono {
    font-size: 0.78rem;
  }

  @media (max-width: 780px) {
    .edu {
      grid-template-columns: 1fr;
    }
  }
</style>
