---
const education = [
  {
    degree: "Engineer's Degree, Software Engineering",
    school: "Universidad Peruana de Ciencias Aplicadas (UPC)",
    place: "Lima, Peru",
    dates: "2015 — 2021",
  },
  {
    degree: "Networking & Data Communications",
    school: "Tecsup",
    place: "Lima, Peru",
    dates: "2012 — 2014",
  },
];

const certifications = [
  { name: "Nest + Reportes: Genera PDF desde Node", issuer: "DevTalles", date: "Jul 2024" },
  { name: "Nest + GraphQL: Evoluciona tus APIs", issuer: "Udemy", date: "Jun 2024" },
  { name: "Nest: Desarrollo Backend Escalable con Node", issuer: "Udemy", date: "May 2024" },
  { name: "Principios SOLID y Clean Code", issuer: "Udemy", date: "Mar 2023" },
  { name: "Node Autentificación REST Clean Architecture", issuer: "DevTalles", date: "Dec 2023" },
  { name: "Futures Thinking", issuer: "Institute for the Future · Coursera", date: "Jul 2021" },
  { name: "Scrum Fundamentals Certified (SFC)", issuer: "SCRUMstudy", date: "Jun 2020" },
];
---

<section id="education">
  <div class="wrap">
    <div class="edu__head">
      <h2 class="edu__title">School taught the fundamentals. Everything after, I kept teaching myself.</h2>
    </div>

    <div class="edu__grid">
      <div class="edu__col">
        <span class="edu__label">Education</span>
        <ul class="edu__list">
          {
            education.map((e) => (
              <li>
                <h3>{e.degree}</h3>
                <span class="edu__meta">{e.school} · {e.place}</span>
                <span class="edu__dates">{e.dates}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="edu__col">
        <span class="edu__label">Certifications</span>
        <ul class="cert__list">
          {
            certifications.map((c) => (
              <li>
                <span class="cert__name">{c.name}</span>
                <span class="cert__meta">{c.issuer} · {c.date}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .edu__head {
    max-width: 60ch;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .edu__title {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.15;
  }

  .edu__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .edu__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu__label {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .edu__list,
  .cert__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--stroke) solid var(--line);
  }

  .edu__list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block: 1.1rem;
    border-bottom: var(--stroke) solid var(--line);
  }

  .edu__list h3 {
    font-size: 1.1rem;
  }

  .edu__meta,
  .edu__dates {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .cert__list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-block: 0.85rem;
    border-bottom: var(--stroke) solid var(--line);
  }

  .cert__name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .cert__meta {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  @media (max-width: 780px) {
    .edu__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
