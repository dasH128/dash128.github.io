---
import { content, formatMonth, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].education;
---

<section id="education">
  <div class="wrap">
    <h2 class="section-title edu__title">{t.title}</h2>

    <h3 class="mono edu__label">{t.studies}</h3>
    <ul class="degrees">
      {
        t.degrees.map((e) => (
          <li class="degree">
            <span class="degree__dates">{e.dates}</span>
            <div class="degree__body">
              <strong>{e.degree}</strong>
              <span>
                {e.school} · {e.place}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <h3 class="mono edu__label edu__label--certs">{t.certs}</h3>
    <ul class="certs">
      {
        t.certifications.map((c) => (
          <li class="cert">
            <strong>{c.name}</strong>
            <span class="cert__issuer">{c.issuer}</span>
            <span class="mono cert__date">{formatMonth(c.date, lang)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The headline is long; it leads in, it does not shout over two degrees and seven courses. */
  .edu__title {
    font-size: clamp(2.2rem, 5.4vw, 4.6rem);
    max-width: 22ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .edu__label {
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-soft);
    padding-bottom: 0.9rem;
  }

  .edu__label--certs {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .degrees,
  .certs {
    list-style: none;
    padding: 0;
    border-top: var(--rule) solid var(--ink);
  }

  /* Degrees: the years lead, in Anton and blue, like the rows of Experience. */
  .degree {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem var(--gutter);
    align-items: baseline;
    padding-block: clamp(1rem, 2vw, 1.4rem);
    border-bottom: var(--rule) solid var(--ink);
  }

  .degree__dates {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1;
    color: var(--blue);
  }

  .degree__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .degree__body strong {
    font-weight: 600;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.3;
  }

  .degree__body span {
    color: var(--ink-soft);
  }

  /* Certifications: a compact table, one line each. */
  .cert {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr) 6.5rem;
    gap: 0.25rem var(--gutter);
    align-items: baseline;
    padding-block: 0.75rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .cert strong {
    font-weight: 600;
    line-height: 1.35;
  }

  .cert__issuer {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .cert__date {
    color: var(--ink-soft);
    text-align: right;
  }

  @media (max-width: 780px) {
    .degree {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .cert {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .cert strong {
      grid-column: 1 / -1;
    }
    .cert__date {
      text-align: left;
      order: 3;
    }
  }
</style>
