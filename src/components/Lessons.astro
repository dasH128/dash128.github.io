---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].about.lessons;
---

<section id="lessons" class="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="how__title" data-reveal>{t.title}</h2>
    <p class="how__sub" data-reveal>{t.sub}</p>

    <ol class="rules">
      {
        t.items.map((it, i) => (
          <li class={`rule r${i + 1}`} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>
              {it.title}
              {it.accent && <> <em>{it.accent}</em></>}
              {it.note && <small>{it.note}</small>}
            </h3>
            <span class="proof">{it.proof}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how__title {
    font-size: clamp(3rem, 8vw, 7.2rem);
    margin-bottom: 0.8rem;
  }
  .how__sub {
    font-family: var(--font-hand);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    color: var(--blue);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    transform: rotate(-1deg);
    transform-origin: left;
  }
  .rules {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.4rem);
  }
  .rule {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    padding: clamp(1.3rem, 2.2vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 260px;
    transition: transform 0.5s var(--ease-out);
  }
  @media (hover: hover) {
    .rule:hover {
      transform: rotate(0) !important;
    }
  }
  .n {
    position: absolute;
    right: 1rem;
    top: -0.4rem;
    font-family: var(--font-display);
    font-size: clamp(5rem, 9vw, 8rem);
    line-height: 1;
    opacity: 0.14;
  }
  .rule h3 {
    position: relative;
    font-size: clamp(1.9rem, 3.1vw, 2.9rem);
    max-width: 16ch;
  }
  .rule h3 em {
    font-style: normal;
  }
  .rule h3 small {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--font-body);
    text-transform: none;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    opacity: 0.85;
  }
  .proof {
    align-self: flex-start;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: var(--rule) solid currentColor;
    border-radius: 99px;
    padding: 0.35rem 0.85rem;
  }
  .proof::before {
    content: "✓";
  }

  .r1 {
    grid-column: 1 / 8;
    background: var(--blue);
    color: #fff;
    transform: rotate(-1deg);
    min-height: 340px;
  }
  .r1 h3 {
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    max-width: 10ch;
  }
  .r2 {
    grid-column: 8 / 13;
    background: var(--ink);
    color: var(--paper);
    transform: rotate(1deg);
  }
  .r2 .proof,
  .r6 .proof {
    color: var(--blue-on-ink);
  }
  .r3 {
    grid-column: 1 / 5;
    background: var(--paper-dim);
    border: var(--rule) solid var(--ink);
    transform: rotate(0.8deg);
  }
  .r4 {
    grid-column: 5 / 9;
    background: #fff;
    box-shadow: var(--shadow-card);
    transform: rotate(-1deg);
  }
  .r4 .proof {
    color: var(--blue);
  }
  .r5 {
    grid-column: 9 / 13;
    background: var(--paper);
    border: var(--rule) solid var(--ink);
    transform: rotate(1deg);
  }
  .r6 {
    grid-column: 1 / 13;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    background: var(--ink);
    color: var(--paper);
  }
  .r6 h3 {
    max-width: none;
  }
  .r6 h3 em {
    color: var(--blue-on-ink);
  }

  @media (max-width: 900px) {
    .r1,
    .r2,
    .r5 {
      grid-column: 1 / 13;
    }
    .r3,
    .r4 {
      grid-column: 1 / 7;
    }
    .rule {
      min-height: 0;
    }
  }
  @media (max-width: 560px) {
    .r3,
    .r4 {
      grid-column: 1 / 13;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rule {
      transition: none;
    }
  }
</style>
