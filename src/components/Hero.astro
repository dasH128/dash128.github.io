---
import Doodle from "./Doodle.astro";
import { content, EMAIL, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<section id="top" class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__a rise" style="--d: 0.05s">{t.lineA}</span>
        <span class="hero__b rise" style="--d: 0.2s">{t.lineB}</span>
      </h1>
      <p class="hero__sub rise" style="--d: 0.4s">{t.sub}</p>
      <div class="hero__actions rise" style="--d: 0.55s">
        <a class="btn" href={`mailto:${EMAIL}`}>{t.cta}</a>
        <a class="link" href="#work">{t.secondary} ↓</a>
      </div>
    </div>

    <figure class="hero__photo">
      <div class="hero__stage" aria-hidden="true"></div>
      <img src="/me/jordy.png" alt={t.photoAlt} width="1024" height="1536" fetchpriority="high" />
      <Doodle variant="tangle" width={150} color="var(--blue)" class="d d--1" />
      <Doodle variant="loop" width={110} color="var(--ink)" class="d d--2" />
      <Doodle variant="flick" width={140} color="var(--blue)" class="d d--3" />
    </figure>
  </div>

  <div class="wrap">
    <dl class="stats" aria-label={t.statsLabel}>
      {
        t.stats.map((s) => (
          <div class="stats__item">
            <dt>{s.n}</dt>
            <dd>{s.l}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    border-top: 0;
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
  }

  .hero__copy {
    grid-column: 1 / span 9;
    grid-row: 1;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-self: center;
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.04em;
    font-size: clamp(3rem, 6.9vw, 6.6rem);
    line-height: 0.92;
  }

  .hero__a {
    color: var(--ink);
  }

  .hero__b {
    color: var(--blue);
    max-width: 17ch;
  }

  .hero__sub {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: min(46ch, 77%);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .hero__photo {
    grid-column: 8 / -1;
    grid-row: 1;
    position: relative;
    z-index: 1;
    margin: 0;
    align-self: end;
    justify-self: end;
    width: min(100%, 400px);
  }

  .hero__stage {
    position: absolute;
    inset: 30% 12% 10% 12%;
    background: var(--blue);
    border: var(--rule) solid var(--ink);
  }

  .hero__photo img {
    position: relative;
    width: 100%;
    height: auto;
    max-height: min(74svh, 640px);
    object-fit: contain;
    object-position: bottom;
  }

  /* :global because the class is passed to <Doodle>, which owns the <svg>. */
  .hero__photo :global(.d) {
    position: absolute;
    z-index: 3;
  }
  .hero__photo :global(.d--1) { top: 4%; left: 2%; }
  .hero__photo :global(.d--2) { top: 30%; right: -2%; }
  .hero__photo :global(.d--3) { bottom: 16%; left: -6%; }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: var(--rule) solid var(--ink);
    position: relative;
    z-index: 3;
    background: var(--paper);
  }

  .stats__item {
    padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1rem, 2vw, 2rem);
    border-right: var(--rule) solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .stats__item:first-child {
    padding-left: 0;
  }

  .stats__item:last-child {
    border-right: 0;
  }

  .stats dt {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.9;
    color: var(--ink);
  }

  .stats__item:last-child dt {
    color: var(--blue);
  }

  .stats dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: 24ch;
    line-height: 1.35;
  }

  .rise {
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }

  /* While the intro curtain is up, hold the entrance until it lifts. */
  :global(html.intro) .rise {
    animation-delay: calc(var(--d, 0s) + 1.1s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @media (max-width: 700px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__copy,
    .hero__photo {
      grid-column: 1;
      grid-row: auto;
    }
    .hero__photo {
      justify-self: center;
      width: min(78%, 360px);
      margin-top: 0.5rem;
    }
    .hero__title {
      font-size: clamp(3rem, 16.5vw, 6rem);
    }
    .hero__b {
      max-width: none;
    }
    .hero__sub {
      max-width: 46ch;
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stats__item {
      border-right: 0;
      border-bottom: var(--rule) solid var(--ink);
      padding-left: 0;
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
    .stats__item:last-child {
      border-bottom: 0;
    }
    .hero__photo :global(.d--3) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }
</style>
