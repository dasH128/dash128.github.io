---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<section id="top" class="hero">
  <h1 class="sr-only">{t.h1}</h1>

  <div class="wrap">
    <div class="stage">
      <!-- Hand-drawn lines behind the photo; the photo's outline cuts them -->
      <svg class="scribble" viewBox="0 0 600 800" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M120 60 C 160 200, 80 300, 130 430 S 90 640, 140 790"></path>
        <path pathLength="1" d="M160 20 C 180 160, 130 260, 170 400 S 150 600, 175 780"></path>
        <path pathLength="1" d="M470 40 C 440 190, 510 300, 465 430 S 505 620, 460 790"></path>
        <path pathLength="1" d="M505 90 C 490 220, 530 330, 500 460 S 525 650, 500 770"></path>
      </svg>

      <span class="big big--hello rise" style="--d: 0.05s" aria-hidden="true">{t.hello}</span>
      <span class="pill pill--route rise" style="--d: 0.35s" aria-hidden="true">{t.pillRoute}</span>

      <figure class="stage__me rise" style="--d: 0.1s">
        <img src="/me/jordy.png" alt={t.photoAlt} width="1024" height="1536" fetchpriority="high" />
      </figure>

      <p class="typed mono rise" style="--d: 0.45s" aria-hidden="true" data-phrases={JSON.stringify(t.typed)}>
        <span class="typed__brace">{"{{"}</span>
        <span class="typed__text">{t.typed[0]}</span><span class="typed__caret">|</span>
        <span class="typed__brace">{"}}"}</span>
      </p>
      <span class="pill pill--years rise" style="--d: 0.5s" aria-hidden="true">{t.pillYears}</span>

      <span class="big big--soy rise" style="--d: 0.2s" aria-hidden="true">{t.soy}</span>
      <div class="name rise" style="--d: 0.3s">
        <p class="name__role mono">{t.role}</p>
        <span class="big" aria-hidden="true">{t.name}</span>
      </div>
    </div>

    <div class="hero__foot">
      <p class="hero__sub rise" style="--d: 0.6s">{t.sub}</p>
      <div class="hero__actions rise" style="--d: 0.7s">
        <a class="btn" href="#work">{t.cta}</a>
        <a class="link" href="#contact">{t.secondary} →</a>
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="stats" aria-label={t.statsLabel}>
      {
        t.stats.map((s) => (
          <div class="stats__item">
            <dt>{s.n}</dt>
            <dd>{s.l}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    border-top: 0;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem);
    overflow: clip;
  }

  /* Stage: the big words sit around (and slightly over) the photo. */
  .stage {
    position: relative;
    height: clamp(500px, calc(100svh - 340px), 740px);
  }

  .big {
    position: absolute;
    z-index: 3;
    font-family: var(--font-display);
    text-transform: uppercase;
    color: var(--blue);
    font-size: clamp(4rem, min(11vw, 17svh), 12rem);
    line-height: 0.82;
  }

  .big--hello {
    left: 0;
    top: 16%;
  }

  .big--soy {
    left: 7%;
    bottom: 22%;
  }

  .name {
    position: absolute;
    right: 0;
    bottom: 22%;
    z-index: 3;
  }

  .name .big {
    position: static;
    display: block;
  }

  .name__role {
    margin-bottom: 0.7rem;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    color: var(--ink);
  }

  /* Taller than the stage so the photo breaks out a little below it. */
  .stage__me {
    position: absolute;
    inset: -1% 0 -9%;
    z-index: 2;
    margin: 0 auto;
    width: fit-content;
  }

  .stage__me img {
    height: 100%;
    width: auto;
    /* Cut-out sticker: black and white with a paper outline. */
    filter: grayscale(1) contrast(1.08) drop-shadow(3px 0 0 var(--paper)) drop-shadow(-3px 0 0 var(--paper))
      drop-shadow(0 3px 0 var(--paper)) drop-shadow(0 -3px 0 var(--paper));
  }

  .scribble {
    position: absolute;
    left: 50%;
    top: 4%;
    width: min(100%, 470px);
    height: 98%;
    translate: -50% 0;
    overflow: visible;
    z-index: 1;
    pointer-events: none;
  }

  .scribble path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    animation: draw 1.6s var(--ease-out) both;
  }

  .scribble path:nth-child(2) { animation-delay: 0.12s; }
  .scribble path:nth-child(3) { animation-delay: 0.24s; }
  .scribble path:nth-child(4) { animation-delay: 0.36s; }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .pill {
    position: absolute;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.55em 1.1em;
    border-radius: 99px;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }

  .pill--route {
    left: 26%;
    top: 6%;
    rotate: -6deg;
  }

  .pill--years {
    right: 18%;
    top: 12%;
    rotate: 5deg;
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .typed {
    position: absolute;
    right: 0;
    top: 31%;
    z-index: 3;
    margin: 0;
    max-width: none;
    font-size: clamp(0.95rem, 1.6vw, 1.5rem);
    letter-spacing: 0;
    text-transform: none;
    color: var(--blue);
    white-space: nowrap;
  }

  .typed__brace {
    opacity: 0.55;
  }

  .typed__caret {
    color: var(--ink);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem);
  }

  .hero__sub {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0;
    position: relative;
    z-index: 3;
  }

  /* One thin rule above each figure instead of a boxed grid. */
  .stats__item {
    padding-top: 1rem;
    border-top: var(--rule) solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .stats dt {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.9;
    color: var(--ink);
  }

  .stats__item:last-child dt {
    color: var(--blue);
  }

  .stats dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: 24ch;
    line-height: 1.35;
  }

  .rise {
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }

  /* While the intro is up, hold the entrance. It starts from zero when the curtain lifts
     (the intro removes `intro` from <html>), whatever the intro's length. */
  :global(html.intro) .rise,
  :global(html.intro) .scribble path {
    animation-play-state: paused;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  /* Small screens: stack. Words keep overlapping the photo through negative margins. */
  @media (max-width: 820px) {
    .stage {
      height: auto;
      display: flex;
      flex-direction: column;
      padding-top: 0.5rem;
    }

    .big,
    .name,
    .pill,
    .typed {
      position: relative;
      inset: auto;
      rotate: none;
    }

    .big {
      font-size: 24vw;
    }

    .name .big {
      font-size: 24vw;
    }

    .pill--route {
      align-self: flex-start;
      margin-top: 0.7rem;
      order: 1;
    }

    .pill--years {
      display: none;
    }

    .big--hello {
      order: 0;
    }

    .stage__me {
      position: relative;
      inset: auto;
      order: 2;
      align-self: center;
      width: min(100%, 440px);
      margin: -14vw 0 -12vw;
    }

    .stage__me img {
      width: 100%;
      height: auto;
    }

    .scribble {
      display: none;
    }

    .typed {
      order: 3;
      align-self: flex-end;
      margin: 1rem 0;
      font-size: 1rem;
    }

    .big--soy {
      order: 4;
    }

    .name {
      order: 5;
      align-self: flex-end;
      text-align: right;
      margin-top: 0.8rem;
    }

    .name__role {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stats {
      gap: 1.25rem;
    }
    .stats__item {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .scribble path {
      animation: none;
    }
    .typed__caret {
      animation: none;
    }
  }
</style>

<script>
  // Types the hero's phrases out in turn. Without JS or with reduced motion, the first
  // phrase stays as plain text.
  const el = document.querySelector<HTMLElement>(".typed");
  const out = el?.querySelector<HTMLElement>(".typed__text");
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && out && !calm) {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? "[]");
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      // Wait for the intro curtain (if any) before starting.
      while (document.documentElement.classList.contains("intro")) await sleep(200);
      await sleep(900);
      for (let p = 0; phrases.length; p++) {
        const w = phrases[p % phrases.length];
        for (let i = 0; i <= w.length; i++) {
          out.textContent = w.slice(0, i);
          await sleep(65);
        }
        await sleep(1700);
        for (let i = w.length; i >= 0; i--) {
          out.textContent = w.slice(0, i);
          await sleep(28);
        }
        await sleep(250);
        // Pause while the tab is hidden instead of burning timers.
        while (document.hidden) await sleep(500);
      }
    })();
  }
</script>
