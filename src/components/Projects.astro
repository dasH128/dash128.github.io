---
import { content, collages, COLLAGE_SIZE, type Lang, type ProjectItem } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].projects;
const items = t.items as readonly ProjectItem[];
---

<section id="work">
  <div class="wrap">
    <h2 class="section-title">{t.title}</h2>

    <ol class="proj">
      {
        items.map((p, i) => {
          const collage = p.collage ? collages[p.collage] : undefined;
          return (
          <li class="proj__row" data-cursor>
            <span class="proj__n mono">{String(i + 1).padStart(2, "0")}</span>
            <div class="proj__head">
              <h3>{p.title}</h3>
              <span class="mono proj__ctx">{p.context}</span>
              {collage && (
                <figure class="proj__collage">
                  <img
                    src={collage.src}
                    alt={collage.alt[lang]}
                    width={COLLAGE_SIZE.width}
                    height={COLLAGE_SIZE.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
            </div>
            <div class="proj__body">
              <p>{p.detail}</p>
              {p.outcome && <p class="proj__outcome">{p.outcome}</p>}
              <ul class="proj__tags mono">
                {p.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              {(p.href || p.demo) && (
                <div class="proj__links">
                  {p.href && (
                    <a class="link" href={p.href}>
                      {t.caseStudy} →
                    </a>
                  )}
                  {p.demo && (
                    <a class="link" href={p.demo} target="_blank" rel="noopener">
                      {t.demo} ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .proj {
    list-style: none;
    padding: 0;
    border-top: var(--rule) solid var(--ink);
  }

  .proj__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
    border-bottom: var(--rule) solid var(--ink);
    transition: background 0.3s var(--ease-out), color 0.3s var(--ease-out), padding 0.4s var(--ease-out);
  }

  .proj__row:last-child {
    border-bottom: 0;
  }

  .proj__n {
    color: var(--ink-soft);
    padding-top: 0.5rem;
  }

  .proj__head {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .proj__head h3 {
    font-size: clamp(1.9rem, 4vw, 3.4rem);
  }

  .proj__ctx {
    color: var(--ink-soft);
  }

  /* Illustrated collage card: a slight tilt that straightens on hover (first piece of the
     softer, more playful visual language; see DESIGN.md). */
  .proj__collage {
    margin: 0.75rem 0 0;
    width: min(100%, 250px);
    transform: rotate(-2deg);
    transition: transform 0.5s var(--ease-out);
  }

  .proj__row:nth-child(even) .proj__collage {
    transform: rotate(2deg);
  }

  .proj__collage img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .proj__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.4rem;
  }

  .proj__body p {
    color: var(--ink-soft);
  }

  .proj__outcome {
    align-self: flex-start;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1;
    padding: 0.4em 0.6em 0.3em;
    background: var(--blue);
    color: #fff !important;
  }

  .proj__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }

  .proj__tags li {
    padding: 0.25em 0.6em;
    border: 1.5px solid currentColor;
  }

  .proj__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  @media (hover: hover) {
    .proj__row:hover {
      background: var(--ink);
      color: var(--paper);
      padding-inline: 1rem;
    }
    .proj__row:hover .proj__n,
    .proj__row:hover .proj__ctx,
    .proj__row:hover .proj__body p {
      color: color-mix(in srgb, var(--paper) 72%, transparent);
    }
    .proj__row:hover .proj__collage {
      transform: rotate(0deg) scale(1.03);
    }
    .proj__row:hover .proj__outcome {
      background: var(--blue-on-ink);
      color: var(--ink) !important;
    }
    .proj__row:hover .link:hover {
      color: var(--blue-on-ink);
    }
  }

  @media (max-width: 820px) {
    .proj__row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .proj__n {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj__row,
    .proj__collage {
      transition: none;
    }
  }
</style>
