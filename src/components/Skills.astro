---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].skills;
---

<section id="stack">
  <div class="wrap">
    <h2 class="section-title">{t.title}</h2>

    <div class="skills" data-skills>
      {
        t.groups.map((g) => (
          <div class="skills__row" data-skills-row>
            <span class="mono skills__label">{g.label}</span>
            <ul class="skills__items">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Scroll focus: the group crossing the middle of the screen fills in, the rest stay outlined.
  const root = document.querySelector<HTMLElement>("[data-skills]");
  const rows = document.querySelectorAll<HTMLElement>("[data-skills-row]");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && rows.length && "IntersectionObserver" in window && !calm) {
    root.classList.add("skills--focus");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.classList.toggle("is-active", e.isIntersecting);
      },
      { rootMargin: "-42% 0px -42% 0px" },
    );
    rows.forEach((r) => io.observe(r));
  }
</script>

<style>
  .skills {
    border-top: var(--rule) solid var(--ink);
  }

  .skills__row {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: var(--rule) solid var(--ink);
    align-items: baseline;
  }

  .skills__row:last-child {
    border-bottom: 0;
  }

  .skills__label {
    color: var(--ink-soft);
  }

  .skills__items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }

  .skills__items li {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    transition: color 0.2s var(--ease-out);
  }

  .skills__items li:hover {
    color: var(--blue);
  }

  @supports (-webkit-text-stroke: 1px #000) {
    .skills--focus .skills__items li {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--ink);
      transition: color 0.45s var(--ease-out), -webkit-text-stroke-color 0.45s var(--ease-out);
    }

    .skills--focus .is-active .skills__items li {
      color: var(--ink);
      -webkit-text-stroke-color: transparent;
    }

    .skills--focus .skills__items li:hover {
      color: var(--blue);
      -webkit-text-stroke-color: var(--blue);
    }

    .skills--focus .is-active .skills__label {
      color: var(--blue);
    }
  }

  @media (max-width: 700px) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills__items li {
      transition: none;
    }
  }
</style>
