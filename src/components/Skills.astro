---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].skills;
---

<section id="stack">
  <div class="wrap">
    <h2 class="section-title">{t.title}</h2>

    <div class="skills" data-skills>
      {
        t.groups.map((g) => (
          <div class="skills__row" data-skills-row>
            <span class="mono skills__label">{g.label}</span>
            <ul class="skills__items">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Scroll focus: only the row closest to the middle of the screen is lit, the rest are dimmed.
  // Without JS or with reduced motion every row stays lit.
  const root = document.querySelector<HTMLElement>("[data-skills]");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-skills-row]")];
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && rows.length && !calm) {
    root.classList.add("skills--focus");
    let queued = false;

    const update = () => {
      queued = false;
      const mid = innerHeight / 2;
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const r of rows) {
        const b = r.getBoundingClientRect();
        const d = Math.abs(b.top + b.height / 2 - mid);
        if (d < bestD) {
          bestD = d;
          best = r;
        }
      }
      // Rows far from the middle (the list is off screen) stay dimmed.
      rows.forEach((r) => r.classList.toggle("is-active", r === best && bestD < innerHeight * 0.4));
    };

    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    update();
  }
</script>

<style>
  /* A darker paper marks the rhythm: the stack is a different beat from the sections around it. */
  #stack {
    background: var(--paper-dim);
  }

  .skills {
    border-top: var(--rule) solid var(--ink);
  }

  .skills__row {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: var(--rule) solid var(--ink);
    align-items: baseline;
  }

  .skills__row:last-child {
    border-bottom: 0;
  }

  .skills__label {
    color: var(--ink-soft);
    font-size: 0.85rem;
    transition: color 0.3s var(--ease-out);
  }

  .skills__items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }

  .skills__items li {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    transition: color 0.35s var(--ease-out);
  }

  .skills__items li:hover {
    color: var(--blue);
  }

  /* Focus mode: dimmed rows stay readable (ink-soft keeps its contrast), the lit one is full ink. */
  .skills--focus .skills__items li {
    color: var(--ink-soft);
  }

  .skills--focus .is-active .skills__items li {
    color: var(--ink);
  }

  .skills--focus .is-active .skills__label {
    color: var(--blue);
  }

  .skills--focus .skills__items li:hover {
    color: var(--blue);
  }

  @media (max-width: 700px) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills__items li,
    .skills__label {
      transition: none;
    }
  }
</style>
