---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].experience;
---

<section id="experience">
  <div class="wrap">
    <h2 class="section-title exp__title">{t.title}</h2>
    <p class="exp__sub">{t.sub}</p>

    <ol class="exp">
      {
        t.roles.map((r, i) => (
          <li class="exp__row">
            <span class="exp__n mono">{String(i + 1).padStart(2, "0")}</span>
            <div class="exp__who">
              <h3>{r.company}</h3>
              <span class="mono">{r.role}</span>
            </div>
            <div class="exp__what">
              <span class="mono exp__dates">
                {r.place} · {r.dates}
              </span>
              <p>{r.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp__title {
    margin-bottom: 1.25rem;
  }

  .exp__sub {
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .exp {
    list-style: none;
    padding: 0;
    border-top: var(--rule) solid var(--ink);
  }

  .exp__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: var(--rule) solid var(--ink);
    transition: padding-left 0.4s var(--ease-out);
  }

  .exp__row:last-child {
    border-bottom: 0;
  }

  .exp__n {
    color: var(--ink-soft);
    padding-top: 0.5rem;
  }

  .exp__who {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .exp__who h3 {
    font-size: clamp(2rem, 4.6vw, 3.9rem);
    transition: color 0.25s var(--ease-out);
  }

  .exp__who .mono {
    color: var(--ink-soft);
  }

  .exp__what {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 0.4rem;
  }

  .exp__dates {
    color: var(--blue);
    font-weight: 500;
  }

  .exp__what p {
    color: var(--ink-soft);
  }

  @media (hover: hover) {
    .exp__row:hover {
      padding-left: 0.75rem;
    }
    .exp__row:hover h3 {
      color: var(--blue);
    }
  }

  @media (max-width: 820px) {
    .exp__row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .exp__n {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp__row,
    .exp__who h3 {
      transition: none;
    }
  }
</style>
