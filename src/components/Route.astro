---
import { content, type Lang } from "../i18n/content";
import { aboutPhoto } from "../lib/aboutPhoto";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].about.route;
const photo = aboutPhoto("porto");
---

<section id="route">
  <div class="wrap">
    <div class:list={["route__head", { "route__head--photo": photo }]}>
      <div>
        <h2 class="section-title">{t.title}</h2>
        <p class="route__text">{t.text}</p>
      </div>
      {
        photo && (
          <figure class="route__photo" data-reveal>
            <img src={photo} alt={t.photoAlt} width="900" height="1200" loading="lazy" decoding="async" />
          </figure>
        )
      }
    </div>

    <figure class="route__map doodle-draw" aria-label={`${t.from} ↔ ${t.to}, ${t.km}`}>
      <svg viewBox="0 0 1000 395" role="img" aria-hidden="true" focusable="false">
        <path class="route__ground" d="M40 300 H960" />
        <path class="route__arc" pathLength="1" d="M130 270 C 340 -40, 660 -40, 870 270" />
        <g class="route__pin route__pin--a">
          <circle cx="130" cy="270" r="14" />
          <text x="130" y="375" text-anchor="middle">{t.from}</text>
        </g>
        <g class="route__pin route__pin--b">
          <circle cx="870" cy="270" r="14" />
          <text x="870" y="375" text-anchor="middle">{t.to}</text>
        </g>
      </svg>
      <figcaption class="mono route__km">{t.km}</figcaption>
    </figure>

    <ul class="route__tags mono">
      {t.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</section>

<style>
  .route__head {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .route__head--photo {
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }

  .route__head .section-title {
    margin-bottom: 1.5rem;
    max-width: none;
  }

  .route__text {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .route__photo {
    margin: 0;
    justify-self: end;
    width: min(100%, 300px);
    border: var(--rule) solid var(--ink);
    box-shadow: 6px 6px 0 var(--blue);
    background: var(--paper-dim);
  }

  .route__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .route__map {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
  }

  .route__map svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .route__ground {
    stroke: var(--ink);
    stroke-width: 2;
    fill: none;
  }

  .route__arc {
    fill: none;
    stroke: var(--blue);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s var(--ease-out);
  }

  .route__map.is-drawn .route__arc {
    stroke-dashoffset: 0;
  }

  .route__pin circle {
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: 4;
    paint-order: stroke;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .route__map.is-drawn .route__pin circle {
    opacity: 1;
  }

  .route__map.is-drawn .route__pin--b circle {
    transition-delay: 1.3s;
    fill: var(--blue);
  }

  .route__pin text {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 44px;
    fill: var(--ink);
    letter-spacing: 0.01em;
  }

  .route__km {
    margin-top: 0.5rem;
    text-align: center;
    color: var(--ink-soft);
  }

  .route__tags {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .route__tags li {
    padding: 0.35em 0.8em;
    border: 1.5px solid var(--ink);
  }

  @media (max-width: 760px) {
    .route__head--photo {
      grid-template-columns: 1fr;
    }
    .route__photo {
      justify-self: start;
      width: min(70%, 260px);
    }
    .route__pin text {
      font-size: 56px;
    }
    .route__arc {
      stroke-width: 10;
    }
    .route__ground {
      stroke-width: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route__arc,
    .route__pin circle {
      transition: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
