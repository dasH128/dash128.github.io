---
import Doodle from "./Doodle.astro";

const year = new Date().getFullYear();
---

<footer id="contact" class="contact">
  <div class="wrap contact__inner">
    <div class="contact__main">
      <h2 class="contact__title">Let's build something that ships.</h2>
      <div class="contact__actions">
        <a class="pill pill--primary" href="mailto:rojas71421@gmail.com">rojas71421@gmail.com</a>
        <a class="link-underline" href="https://www.linkedin.com/in/dash128/" target="_blank" rel="noopener noreferrer">
          LinkedIn ↗
        </a>
      </div>
      <Doodle variant="underline" width={140} class="contact__doodle" />
    </div>

    <div class="contact__meta">
      <div class="contact__mark" aria-hidden="true">JR</div>
      <p class="contact__loc">Porto, Portugal</p>
      <p class="contact__lang">Español (native) · Português (B2) · English (B1)</p>
    </div>
  </div>

  <div class="wrap contact__bar">
    <span>© {year} Jordy Rojas Aliaga. Built with Astro.</span>
  </div>
</footer>

<style>
  .contact {
    background: var(--night);
    color: var(--night-ink);
    padding-block: clamp(4rem, 9vw, 7rem) 2rem;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid rgba(244, 239, 227, 0.18);
  }

  .contact__main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact__title {
    color: var(--night-ink);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    max-width: 14ch;
  }

  .contact__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .contact__doodle {
    color: rgba(244, 239, 227, 0.5);
    margin-top: 0.5rem;
  }

  .contact__meta {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
    justify-content: flex-end;
  }

  .contact__mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    border: var(--stroke) solid rgba(244, 239, 227, 0.65);
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 700;
  }

  .contact__loc,
  .contact__lang {
    color: rgba(244, 239, 227, 0.72);
    font-size: 0.95rem;
    max-width: none;
  }

  .contact__bar {
    padding-top: 1.75rem;
    font-size: 0.85rem;
    color: rgba(244, 239, 227, 0.55);
  }

  @media (max-width: 720px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
    .contact__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
