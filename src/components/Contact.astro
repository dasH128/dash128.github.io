---
import Doodle from "./Doodle.astro";
import { content, EMAIL, LINKEDIN, GITHUB, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].contact;
const year = new Date().getFullYear();
---

<footer id="contact" class="contact">
  <div class="wrap">
    <!-- 1. Opening: phone + copyable email -->
    <div class="call">
      <figure class="call__art">
        <img class="phone" src="/contact/phone.png" alt={t.phoneAlt} width="520" height="513" loading="lazy" decoding="async" />
      </figure>
      <div class="call__body">
        <p class="mono call__lead">{t.lead}</p>
        <button
          class="mail"
          type="button"
          data-email={EMAIL}
          data-copied={t.copied}
          data-failed={t.copyFailed}
          aria-describedby="mail-hint"
        >
          {EMAIL}
        </button>
        <p class="mono hint" id="mail-hint">{t.copyHint}</p>
        <div class="actions">
          <a class="pill pill--ghost" href={LINKEDIN} target="_blank" rel="noopener noreferrer">{t.linkedin} ↗</a>
          <a class="pill pill--ghost" href={GITHUB} target="_blank" rel="noopener noreferrer">{t.github} ↗</a>
        </div>
      </div>
    </div>

    <!-- 2. The contract -->
    <div class="contract">
      <h2 class="contact__title">{t.title}</h2>
      <p class="contact__intro">{t.intro}</p>

      <ol class="clauses">
        {
          t.clauses.map((c, i) => (
            <li class="clause">
              <span class="clause__n">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{c.h}</h3>
                <p>{c.p}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- 3. Signature closes the contract -->
    <div class="sign">
      <div class="sign__who">
        <span class="mono">{t.signed}</span>
        <span class="sign__name">Jordy Rojas Aliaga</span>
        <Doodle variant="underline" width={260} color="var(--blue-on-ink)" class="sign__doodle" />
      </div>
      <a class="pill pill--solid" href={`mailto:${EMAIL}`}>{t.cta} →</a>
    </div>

    <div class="contact__bar mono">
      <span>© {year} Jordy Rojas Aliaga · {t.copyright}</span>
      <span>{t.loc} · {t.lang}</span>
    </div>
  </div>

  <div class="toast" role="status" aria-live="polite"></div>
</footer>

<style>
  .contact {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 9vw, 8rem) 2rem;
  }

  /* Opening */
  .call {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .call__art {
    margin: 0;
  }

  .phone {
    width: min(100%, 380px);
    height: auto;
    transform-origin: 50% 80%;
    transform: rotate(-6deg);
  }

  .call__art:hover .phone {
    animation: ring 0.5s ease-in-out 3;
  }

  @keyframes ring {
    25% {
      transform: rotate(-12deg);
    }
    75% {
      transform: rotate(0deg);
    }
  }

  .call__lead {
    color: var(--blue-on-ink);
  }

  .mail {
    display: block;
    max-width: 100%;
    margin: 0.7rem 0 0.5rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--paper);
    text-align: left;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1;
    font-size: clamp(1.7rem, 4.2vw, 4.1rem);
    overflow-wrap: anywhere;
    transition: color 0.25s var(--ease-out);
  }

  .mail:hover {
    color: var(--blue-on-ink);
  }

  /* Blue on ink fails contrast for the focus ring, so use the light accent here. */
  .contact :global(:focus-visible) {
    outline-color: var(--blue-on-ink);
  }

  .hint {
    color: color-mix(in srgb, var(--paper) 62%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em 1.3em;
    border-radius: 99px;
    border: 1.5px solid var(--paper);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .pill:hover {
    transform: translateY(-2px);
  }

  .pill--solid {
    background: var(--paper);
    color: var(--ink);
  }

  .pill--solid:hover {
    background: var(--blue-on-ink);
    border-color: var(--blue-on-ink);
  }

  .pill--ghost {
    background: transparent;
    color: var(--paper);
  }

  .pill--ghost:hover {
    background: var(--paper);
    color: var(--ink);
  }

  /* Contract */
  .contract {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .contact__title {
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    max-width: 14ch;
    color: var(--paper);
  }

  .contact__intro {
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: 1.1rem;
  }

  .clauses {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: var(--rule) solid var(--paper);
  }

  .clause {
    display: grid;
    grid-template-columns: clamp(3.5rem, 8vw, 7rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: var(--rule) solid var(--paper);
  }

  .clause__n {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 0.9;
    color: var(--blue-on-ink);
  }

  .clause h3 {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    color: var(--paper);
  }

  .clause p {
    margin-top: 0.5rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  /* Signature */
  .sign {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .sign__who {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sign__who .mono {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }

  .sign__name {
    font-family: var(--font-hand);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .contact__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-size: 0.72rem;
  }

  /* Copy confirmation */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 60;
    transform: translate(-50%, 200%);
    background: var(--paper);
    color: var(--ink);
    padding: 0.85em 1.4em;
    border-radius: 99px;
    font-weight: 600;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
    transition: transform 0.5s var(--ease-out);
  }

  .toast.is-on {
    transform: translate(-50%, 0);
  }

  @media (max-width: 820px) {
    .call {
      grid-template-columns: 1fr;
    }
    .phone {
      width: min(70%, 280px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .call__art:hover .phone {
      animation: none;
    }
    .pill,
    .mail,
    .toast {
      transition: none;
    }
  }
</style>

<script>
  const mail = document.querySelector<HTMLButtonElement>(".contact .mail");
  const toast = document.querySelector<HTMLElement>(".contact .toast");

  if (mail && toast) {
    let timer: number | undefined;
    const say = (msg: string) => {
      toast.textContent = msg;
      toast.classList.add("is-on");
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove("is-on"), 2400);
    };

    mail.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(mail.dataset.email ?? "");
        say(mail.dataset.copied ?? "");
      } catch {
        // Clipboard blocked (http, old browser): select the text so Cmd/Ctrl+C works.
        const range = document.createRange();
        range.selectNodeContents(mail);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        say(mail.dataset.failed ?? "");
      }
    });
  }
</script>
