---
import Doodle from "./Doodle.astro";
import { content, EMAIL, LINKEDIN, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].contact;
const year = new Date().getFullYear();
---

<footer id="contact" class="contact">
  <div class="wrap">
    <h2 class="contact__title">{t.title}</h2>
    <p class="contact__intro">{t.intro}</p>

    <ol class="clauses">
      {
        t.clauses.map((c, i) => (
          <li class="clause">
            <span class="clause__n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{c.h}</h3>
              <p>{c.p}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="sign">
      <div class="sign__who">
        <span class="mono">{t.signed}</span>
        <span class="sign__name">Jordy Rojas Aliaga</span>
        <Doodle variant="underline" width={260} color="var(--blue-on-ink)" class="sign__doodle" />
      </div>
      <div class="sign__actions">
        <a class="btn btn--paper" href={`mailto:${EMAIL}`}>{t.cta} · {EMAIL}</a>
        <a class="link" href={LINKEDIN} target="_blank" rel="noopener noreferrer">{t.linkedin} ↗</a>
      </div>
    </div>

    <div class="contact__bar mono">
      <span>© {year} Jordy Rojas Aliaga · {t.copyright}</span>
      <span>{t.loc} · {t.lang}</span>
    </div>
  </div>
</footer>

<style>
  .contact {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 9vw, 8rem) 2rem;
  }

  .contact__title {
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    max-width: 14ch;
    color: var(--paper);
  }

  .contact__intro {
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: 1.1rem;
  }

  .clauses {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: var(--rule) solid var(--paper);
  }

  .clause {
    display: grid;
    grid-template-columns: clamp(3.5rem, 8vw, 7rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: var(--rule) solid var(--paper);
  }

  .clause__n {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 0.9;
    color: var(--blue-on-ink);
  }

  .clause h3 {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    color: var(--paper);
  }

  .clause p {
    margin-top: 0.5rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  .sign {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .sign__who {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sign__who .mono {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }

  .sign__name {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .sign__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .sign__actions .link:hover {
    color: var(--blue-on-ink);
  }

  .contact__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-size: 0.72rem;
  }
</style>
