---
import { content, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].about.off;
const [kid, sunday, bug] = t.items;
---

<section class="off" aria-labelledby="off-title">
  <div class="wrap">
    <h2 id="off-title" class="off__title" data-reveal>{t.title} <span>{t.accent}</span></h2>
    <p class="off__lead" data-reveal>{t.lead}</p>

    <div class="off__grid">
      <div class="crop c1" role="img" aria-label={t.cropAlts[0]} data-reveal></div>
      <article class="qa qa1" data-reveal>
        <span class="mono">{kid.label}</span>
        <h3>{kid.title}</h3>
        <p>{kid.text}</p>
      </article>
      <article class="qa qa2" data-reveal>
        <span class="mono">{sunday.label}</span>
        <h3>{sunday.title}</h3>
        <p>{sunday.text}</p>
      </article>
      <article class="qa qa3" data-reveal>
        <span class="mono">{bug.label}</span>
        <h3>{bug.title}</h3>
        <p>{bug.text}</p>
      </article>
      <div class="crop c2" role="img" aria-label={t.cropAlts[1]} data-reveal></div>
      <div class="crop c3" role="img" aria-label={t.cropAlts[2]} data-reveal></div>
    </div>
  </div>
</section>

<style>
  .off {
    background: var(--ink);
    color: var(--paper);
  }
  .off__title {
    font-size: clamp(3rem, 8vw, 7.2rem);
    margin-bottom: 1rem;
  }
  .off__title span {
    color: var(--blue-on-ink);
  }
  .off__lead {
    max-width: 36em;
    color: rgba(244, 241, 232, 0.75);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .off__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
    align-items: stretch;
  }

  /* Three crops of the same portrait. */
  .crop {
    border-radius: var(--radius-card);
    background-image: url("/me/about/hero.webp");
    background-repeat: no-repeat;
    box-shadow: 0 24px 40px -24px #000;
    min-height: 260px;
  }
  .c1 {
    grid-column: 1 / 4;
    aspect-ratio: 4 / 5;
    background-size: 300% auto;
    background-position: 42.5% 11%;
    transform: rotate(-2deg);
  }
  .c2 {
    grid-column: 6 / 9;
    grid-row: 2;
    aspect-ratio: 4 / 5;
    background-size: 300% auto;
    background-position: 52% 54%;
    transform: rotate(1.5deg);
  }
  .c3 {
    grid-column: 9 / 13;
    grid-row: 2;
    background-size: 240% auto;
    background-position: 59% 100%;
    transform: rotate(-1deg);
  }

  .qa {
    border: var(--rule) solid rgba(244, 241, 232, 0.3);
    border-radius: 14px;
    padding: 1.5rem 1.6rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .qa .mono {
    color: var(--blue-on-ink);
  }
  .qa h3 {
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    color: var(--paper);
  }
  .qa p {
    color: rgba(244, 241, 232, 0.85);
    line-height: 1.55;
  }
  .qa1 {
    grid-column: 4 / 9;
  }
  .qa2 {
    grid-column: 9 / 13;
  }
  .qa3 {
    grid-column: 1 / 6;
    grid-row: 2;
    background: var(--blue-on-ink);
    border-color: var(--blue-on-ink);
  }
  .qa3 .mono,
  .qa3 h3,
  .qa3 p {
    color: var(--ink);
  }

  @media (max-width: 1000px) {
    .c1 {
      grid-column: 1 / 5;
    }
    .qa1 {
      grid-column: 5 / 13;
    }
    .qa2 {
      grid-column: 1 / 13;
    }
    .qa3 {
      grid-column: 1 / 13;
      grid-row: auto;
    }
    .c2 {
      grid-column: 1 / 7;
      grid-row: auto;
    }
    .c3 {
      grid-column: 7 / 13;
      grid-row: auto;
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 640px) {
    .c1,
    .qa1 {
      grid-column: 1 / 13;
    }
    .c1 {
      aspect-ratio: 1;
    }
    .c2,
    .c3 {
      grid-column: 1 / 13;
      aspect-ratio: 1;
    }
  }
</style>
