---
---

<header class="nav">
  <div class="wrap nav__row">
    <a href="#top" class="nav__mark" aria-label="Jordy Rojas Aliaga — home">
      <span>JR</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#experience">Experience</a>
      <a href="#stack">Stack</a>
      <a href="#education">Education</a>
    </nav>

    <a href="#contact" class="pill pill--primary nav__cta">Contact</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 1.1rem;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }

  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: var(--stroke) solid var(--line);
    background: var(--paper);
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 3vw, 2.5rem);
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 500;
    font-size: 0.98rem;
  }

  .nav__links a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav__cta {
    padding-block: 0.62em;
    font-size: 0.92rem;
  }

  @media (max-width: 640px) {
    .nav__row {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }
    .nav__links {
      order: 3;
      width: 100%;
      justify-content: center;
      font-size: 0.88rem;
    }
  }
</style>
