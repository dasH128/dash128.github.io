---
import { content, langs, langPath, aboutPath, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  /** Where the nav is rendered. Section links on other pages point back to the home page. */
  page?: "home" | "about";
}
const { lang, page = "home" } = Astro.props;
const t = content[lang].nav;

const home = langPath(lang);
const section = (id: string) => (page === "home" ? `#${id}` : `${home}#${id}`);
// Same page, other language.
const switchTo = (l: Lang) => (page === "about" ? aboutPath(l) : langPath(l));

// Same order as the sections on the home page (see pages/[lang]/index.astro).
const links = [
  { href: aboutPath(lang), label: t.about, current: page === "about" },
  { href: section("experience"), label: t.experience, id: "experience" },
  { href: section("work"), label: t.work, id: "work" },
  { href: section("stack"), label: t.stack, id: "stack" },
  { href: section("education"), label: t.education, id: "education" },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a href={page === "home" ? "#top" : home} class="nav__mark" aria-label={t.home}>jordy<span>.</span></a>

    <nav class="nav__links mono" aria-label={t.aria}>
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.current ? "page" : undefined} data-section={page === "home" ? l.id : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__end">
      <span class="nav__clock mono" aria-hidden="true">{t.clock} <b data-clock>--:--</b></span>

      <div class="nav__lang mono" role="group" aria-label={t.langLabel}>
        {
          langs.map((l) => (
            <a
              href={switchTo(l)}
              data-lang={l}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? "true" : undefined}
            >
              {l}
            </a>
          ))
        }
      </div>

      <a href="#contact" class="nav__cta">{t.cta} →</a>

      <button
        class="nav__burger"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label={t.menuOpen}
        data-open-label={t.menuOpen}
        data-close-label={t.menuClose}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Hidden with visibility, so closed links are out of the tab order and the a11y tree. -->
  <nav class="menu" id="nav-menu" aria-label={t.aria}>
    <ol>
      {
        links.map((l, i) => (
          <li>
            <a href={l.href} aria-current={l.current ? "page" : undefined} data-section={page === "home" ? l.id : undefined}>
              <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ol>
    <a href="#contact" class="menu__cta">{t.cta} →</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: var(--rule) solid var(--ink);
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .nav__row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 0.65rem;
  }

  /* Logo: handwritten, tilted, blue name with an ink full stop. */
  .nav__mark {
    font-family: var(--font-hand);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
    color: var(--blue);
    display: inline-block;
    transform: rotate(-4deg);
    transition: transform 0.3s var(--ease-out);
  }

  .nav__mark span {
    color: var(--ink);
  }

  .nav__mark:hover {
    transform: rotate(-1deg) scale(1.05);
  }

  /* Links live in one outlined pill. */
  .nav__links {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    padding: 0.55rem 1.2rem;
    border: 1.5px solid var(--ink);
    border-radius: 99px;
    background: var(--paper);
  }

  .nav__links a {
    position: relative;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Underline that slides in on hover and stays on the current page. */
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1.5px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .nav__links a:hover::after,
  .nav__links a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__links a[aria-current] {
    color: var(--blue);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav__clock {
    display: none;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .nav__clock b {
    font-weight: 500;
    color: var(--blue);
  }

  @media (min-width: 1100px) {
    .nav__clock {
      display: inline;
    }
  }

  /* Language switch: a segmented pill, the current language filled. */
  .nav__lang {
    display: flex;
    padding: 3px;
    border: 1.5px solid var(--ink);
    border-radius: 99px;
  }

  .nav__lang a {
    text-decoration: none;
    color: var(--ink);
    padding: 0.3em 0.75em;
    border-radius: 99px;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav__lang a:hover {
    background: var(--paper-dim);
  }

  .nav__lang a[aria-current="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .nav__cta {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.55em 1.1em;
    border-radius: 99px;
    background: var(--blue);
    color: #fff;
    border: 1.5px solid var(--blue);
    transition: background 0.2s var(--ease-out), border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .nav__cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    transform: translateY(-1px);
  }

  .nav__burger {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
    place-content: center;
    gap: 5px;
  }

  .nav__burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.35s var(--ease-out), opacity 0.2s;
  }

  .nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Full-screen menu (small screens only). */
  .menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__burger {
      display: grid;
    }

    .menu {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      padding: 6rem var(--gutter) 2.5rem;
      background: var(--blue);
      color: #fff;
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.55s var(--ease-out), visibility 0s 0.55s;
    }

    .nav.is-open .menu {
      visibility: visible;
      clip-path: inset(0);
      transition: clip-path 0.55s var(--ease-out), visibility 0s;
    }

    .menu ol {
      list-style: none;
      padding: 0;
    }

    .menu ol a {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      padding-block: 0.15em;
      font-family: var(--font-display);
      text-transform: uppercase;
      text-decoration: none;
      font-size: clamp(2.6rem, 12vw, 5rem);
      line-height: 1;
    }

    .menu ol a span {
      font-size: 0.78rem;
      margin-top: 0.9em;
      opacity: 0.75;
    }

    .menu ol a[aria-current] {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 6px;
    }

    .menu__cta {
      align-self: flex-start;
      font-weight: 600;
      text-decoration: none;
      padding: 0.8em 1.4em;
      border-radius: 99px;
      background: var(--paper);
      color: var(--ink);
    }

    /* While open, the bar sits on the blue menu. */
    .nav.is-open {
      background: transparent;
      border-bottom-color: transparent;
    }
    .nav.is-open .nav__mark,
    .nav.is-open .nav__mark span {
      color: #fff;
    }
    .nav.is-open .nav__lang,
    .nav.is-open .nav__burger {
      border-color: #fff;
    }
    .nav.is-open .nav__lang a {
      color: #fff;
    }
    .nav.is-open .nav__lang a[aria-current="true"] {
      background: #fff;
      color: var(--blue);
    }
    .nav.is-open .nav__burger {
      background: transparent;
    }
    .nav.is-open .nav__burger span {
      background: #fff;
    }
  }

  @media (max-width: 420px) {
    .nav__end {
      gap: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .nav.is-open .menu,
    .nav__links a::after,
    .nav__mark,
    .nav__burger span {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const burger = nav?.querySelector<HTMLButtonElement>(".nav__burger");
  const menu = nav?.querySelector<HTMLElement>(".menu");

  if (nav && burger && menu) {
    // Everything outside the header becomes inert while the menu is open, so Tab and
    // screen readers stay inside it.
    const others = () => [...document.body.children].filter((el) => el !== nav && el.tagName !== "SCRIPT");

    const setOpen = (open: boolean, restoreFocus = false) => {
      nav.classList.toggle("is-open", open);
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? "");
      document.documentElement.style.overflow = open ? "hidden" : "";
      others().forEach((el) => (el as HTMLElement).toggleAttribute("inert", open));
      if (open) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      else if (restoreFocus) burger.focus();
    };

    burger.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) setOpen(false);
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) setOpen(false, true);
    });
    // Leaving the small-screen layout while open would strand the page with no scroll.
    matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Scroll-spy: on the home page, mark the link of the section under the middle of the
  // viewport. `aria-current="location"` is the right value for "where you are on this page".
  const spy = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav] a[data-section]")];
  if (spy.length) {
    const sections = [...new Set(spy.map((a) => a.dataset.section!))]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    let queued = false;
    const update = () => {
      queued = false;
      const line = innerHeight * 0.4;
      const current = sections.find((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= line && r.bottom > line;
      });
      spy.forEach((a) => {
        if (current && a.dataset.section === current.id) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    update();
  }

  // Live Porto clock (decorative, hidden from assistive tech).
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  if (clock) {
    const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Lisbon", hour: "2-digit", minute: "2-digit" });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 20000);
  }
</script>
