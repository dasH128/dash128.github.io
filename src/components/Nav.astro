---
import { content, langs, langPath, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].nav;
---

<header class="nav">
  <div class="wrap nav__row">
    <a href="#top" class="nav__mark" aria-label={t.home}>JR<span>.</span></a>

    <nav class="nav__links mono" aria-label={t.aria}>
      <a href="#work">{t.work}</a>
      <a href="#experience">{t.experience}</a>
      <a href="#stack">{t.stack}</a>
      <a href="#education">{t.education}</a>
    </nav>

    <div class="nav__end">
      <div class="nav__lang mono" role="group" aria-label={t.langLabel}>
        {
          langs.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              <a
                href={langPath(l)}
                data-lang={l}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? "true" : undefined}
              >
                {l}
              </a>
            </>
          ))
        }
      </div>
      <a href="#contact" class="nav__cta">{t.cta} →</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: var(--rule) solid var(--ink);
  }

  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 0.7rem;
  }

  .nav__mark {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .nav__mark span {
    color: var(--blue);
  }

  .nav__links {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  .nav__links a,
  .nav__lang a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.2s var(--ease-out);
  }

  .nav__links a:hover,
  .nav__lang a:hover {
    color: var(--ink);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__lang {
    display: flex;
    gap: 0.35rem;
    color: var(--ink-soft);
  }

  .nav__lang a[aria-current="true"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .nav__cta {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.5em 0.95em;
    border: var(--rule) solid var(--ink);
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
    white-space: nowrap;
  }

  .nav__cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 760px) {
    .nav__row {
      flex-wrap: wrap;
      row-gap: 0.4rem;
    }
    .nav__links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      padding-bottom: 0.2rem;
    }
  }

  @media (max-width: 420px) {
    .nav__cta {
      display: none;
    }
  }
</style>
