---
import { content, covers, projectPath, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].about.built;
---

<section id="built">
  <div class="wrap">
    <h2 class="section-title">{t.title}</h2>
    <p class="built__intro">{t.intro}</p>

    <ul class="built__grid">
      {
        t.items.map((it, i) => {
          const cover = covers[it.slug];
          return (
            <li class="card" data-cursor data-reveal style={`--d:${i * 0.12}s`}>
              {cover && (
                <figure class={`card__cover card__cover--${cover.fit}`}>
                  <img
                    src={cover.src}
                    alt={cover.alt[lang]}
                    width={cover.width}
                    height={cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              <div class="card__body">
                <span class="mono card__year">{it.year}</span>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
                <a class="link" href={projectPath(lang, it.slug)}>
                  {t.cta} →
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .built__intro {
    margin-top: calc(-1 * clamp(1.5rem, 4vw, 3rem));
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  .built__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: var(--rule) solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--blue);
  }

  .card__cover {
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--blue);
    border-bottom: var(--rule) solid var(--ink);
    overflow: hidden;
  }

  .card__cover img {
    width: 100%;
    height: 100%;
  }

  .card__cover--cover img {
    object-fit: cover;
    object-position: top;
  }

  .card__cover--contain img {
    object-fit: contain;
    padding-top: 0.9rem;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.5rem;
    flex: 1;
  }

  .card__year {
    color: var(--blue);
    font-weight: 500;
  }

  .card h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .card p {
    color: var(--ink-soft);
    flex: 1;
  }

  .card .link {
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .built__grid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
